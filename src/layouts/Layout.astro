---
import '../styles/global.css'  
import Navbar from '../components/NavBar.astro';
import Footer from "../components/Footer.astro";

type NavLink = {
	label: string;
	href: string;
	external?: boolean;
};

interface Props {
	navLinks?: NavLink[];
}

const { navLinks } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
    	<meta charset="UTF-8" />
    	<meta name="viewport" content="width=device-width" />
    	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    	<meta name="generator" content={Astro.generator} />
    	<title>Portfolio</title>
    	<!-- À ajouter plus tard : meta description, OG -->
    </head>
    <body class="min-h-screen flex flex-col">
    	<Navbar links={navLinks} />
		<main>
    		<slot />
		</main>
		<footer class="border-t bg-primary-900 dark:bg-secondary-500 w-full dark:text-white transition-colors duration-300 	mt-30">
			<Footer />
		</footer>
	</body>
</html>

<script>
	document.addEventListener('navbar-position-change', (e) => {
    const event = e as CustomEvent<{ atTop: boolean }>;
    document.body.classList.toggle('navbar-top', event.detail.atTop);
});
</script>

<style>
    html, body {
    	margin: 0;
    	width: 100%;
    	min-height: 100vh;
    }
	body {
    	transition: padding 0.35s ease;
	}
</style>
