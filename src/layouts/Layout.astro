---
import '../styles/global.css'  
import Navbar from '../components/NavBar.astro';
---

<!doctype html>
<html lang="fr">
	<head>
    	<meta charset="UTF-8" />
    	<meta name="viewport" content="width=device-width" />
    	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    	<meta name="generator" content={Astro.generator} />
    	<title>Portfolio</title>
    	<!-- À ajouter plus tard : meta description, OG -->
    </head>
    <body>
    	<Navbar />
    	<slot />
    </body>
</html>

<script>
	document.addEventListener('navbar-position-change', (e) => {
    const event = e as CustomEvent<{ atTop: boolean }>;
    document.body.classList.toggle('navbar-top', event.detail.atTop);
});
</script>

<style>
    html, body {
    	margin: 0;
    	width: 100%;
    	min-height: 100vh;
    }
    body {
    	padding-bottom: 56px;
    }
	body {
    	transition: padding 0.35s ease;
  	}
  	body.navbar-top {
    	padding-top: 56px;
    	padding-bottom: 0;
  	}
  	body:not(.navbar-top) {
    	padding-bottom: 56px;
    	padding-top: 0;
 	}
</style>
