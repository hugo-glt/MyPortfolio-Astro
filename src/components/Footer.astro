---
const year = new Date().getFullYear();
---

<footer class=" bg-primary-300 w-full dark:bg-secondary-500  dark:text-white transition-colors duration-300">
    <div class="mx-auto flex items-center justify-center max-w-7xl px-6 py-10 lg:px-8">
        <div>
            <div class="flex items-center justify-center gap-10">
            <div>
                <h3 class="font-bold text-black text-2xl">Hugo Gilet</h3>
                <div class="mt-2 text-sm w-0 md:w-75 text-center md:text-left">
                    <span>Fullstack developer in training. Passionate about computers, software design, and web applications.</span>
                </div>
            </div>
            <div>
                <ul>
                    <li><a href="/privacypolicy" class="text-gray-300 hover:text-white">Privacy Policy</a></li>
                    <li><a href="/credits&licenses" class="text-gray-300 hover:text-white">Credits and Licenses</a></li>
                    <li><a href="/legalnotices" class="text-gray-300 hover:text-white">Legal Notices</a></li>
                </ul>
            </div>
            </div>
            <!-- Copyright -->
            <div class="mt-10 border-t pt-6 md:col-span-3">
                <p class="text-center text-sm text-primary-200 dark:text-secondary-200">
                    © {year} MonSite. All rights reserved.
                </p>
            </div>
        </div>
    </div>
</footer>

