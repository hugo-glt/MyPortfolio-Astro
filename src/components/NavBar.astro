---
import SettingsIcon from '../components/icons/SettingsIcon.astro';
import MoonIcon from '../components/icons/MoonIcon.astro';
import SunIcon from '../components/icons/SunIcon.astro';
import LeftArrow from '../components/icons/ArrowLeftIcon.astro';

export interface NavLink {
    label: string;
    href: string;
}

interface Props {
    links?: NavLink[];
    backArrowSrc?: string;
    pinned?: boolean;
}

const DEFAULT_LINKS: NavLink[] = [
    { label: 'PRESENTATION', href: '#presentation' },
    { label: 'PROJECTS', href: '#projects' },
    { label: 'CONTACTS', href: '#contacts' },
];

const {
    links = DEFAULT_LINKS,
    pinned = false,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
---

<nav id="navbar" class:list={[
        'navbar fixed left-0 right-0 h-12 bg-primary-300 dark:bg-secondary-500 transition-all duration-300 ease-out z-100 isolation-isolate',
        pinned ? 'pinned' : 'bottom-0 top-auto',
    ]}
    data-pinned={pinned}>
    {!isHome && (
        <a
            href="/#projects"
            class="absolute left-4 top-1/2 -translate-y-1/2 p-2 rounded-lg hover:bg-white/10 transition"
            aria-label="Back to Home">
            <LeftArrow class="w-6 h-6" />
        </a>
    )}
    <div class="flex items-center justify-center h-full gap-12">
        {links.map((link) => (
            <a href={link.href} class="font-bold">
                {link.label}
            </a>
        ))}
    </div>
    <button 
        id="settings-btn"
        class="absolute right-4 top-1/2 -translate-y-1/2 p-2 rounded-lg hover:bg-white/10 transition"
        aria-expanded="false"
        aria-controls="settings-menu"
        aria-label="Open Settings Menu">
        <SettingsIcon class="w-8 h-8 text-primary-200 dark:text-secondary-200" />
    </button>
    <div id="settings-menu" class="settings-menu flex flex-col items-center justify-center p-3 m-3 " role="menu" aria-orientation="vertical">
        <div class="flex items-center justify-center gap-3">
            <SunIcon class="w-6 h-6 text-primary-200 dark:text-secondary-200"/>
            <button id="dark-switch" class="dark-switch relative h-6 w-11 rounded-full bg-primary-200 dark:bg-secondary-200" role="switch" aria-checked="false" aria-label="Toggle Dark Mode">
			    <span class="switch-knob absolute left-1 top-1 h-4 w-4 rounded-full bg-white"></span>
		    </button>
            <MoonIcon class="w-6 h-6 text-primary-200 dark:text-secondary-200"/>
        </div>
	<div class="mt-4">
		<label class="mb-2 flex flex-col justify-center items-center font-bold">Language</label>
		<select class="w-full rounded-lg border px-3 py-2">
			<option>English</option>
			<option>Français</option>
		</select>
        </div>
	</div>

</nav>



<script>
    const hero = document.getElementById('hero');
    const navbar = document.getElementById('navbar');
    const settingsBtn = document.getElementById('settings-btn') as HTMLButtonElement;
    const settingsMenu = document.getElementById('settings-menu') as HTMLElement;
    const darkSwitch = document.getElementById('dark-switch') as HTMLButtonElement;
    const isPinned = navbar?.dataset.pinned === 'true';

    if (!settingsBtn || !settingsMenu) {
        throw new Error('Settings menu elements not found');
    }

    const menu = settingsMenu;
    let isMenuOpen = false;
    
        if (hero && navbar) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    navbar.classList.add('transitioning');
                    navbar.offsetHeight;

                    if (!entry.isIntersecting) {
                        navbar.classList.add('scrolled');
                    } else {
                        navbar.classList.remove('scrolled');
                    }

                    navbar.dispatchEvent(new CustomEvent('navbar-position-change', {
                        detail: { atTop: !entry.isIntersecting }
                    }));

                    setTimeout(() => {
                        navbar.classList.remove('transitioning');
                    }, 450);
                });
            }, { threshold: 0 });

            observer.observe(hero);
        }
     // --- Menu Toggle ---
    function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    menu.classList.toggle('open', isMenuOpen);
    settingsBtn.setAttribute('aria-expanded', String(isMenuOpen));
    
    if (isMenuOpen) {
      // Focus premier élément
    menu.querySelector<HTMLElement>('[role="menuitem"]')?.focus();
    document.addEventListener('click', handleOutsideClick);
    document.addEventListener('keydown', handleKeydown);
    } else {
    document.removeEventListener('click', handleOutsideClick);
    document.removeEventListener('keydown', handleKeydown);
    }
    }

    function closeMenu() {
    if (isMenuOpen) {
        isMenuOpen = false;
        menu.classList.remove('open');
        settingsBtn.setAttribute('aria-expanded', 'false');
        document.removeEventListener('click', handleOutsideClick);
        document.removeEventListener('keydown', handleKeydown);
    }
    }

    function handleOutsideClick(e: MouseEvent) {
    if (!(e.target instanceof Node) || (!settingsBtn.contains(e.target) && !menu.contains(e.target))) {
        closeMenu();
    }
    }

    function handleKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape') closeMenu();
    // Navigation clavier dans le menu
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const items = Array.from(menu.querySelectorAll<HTMLElement>('[role="menuitem"]'));
        const current = document.activeElement;
        const index = items.indexOf(current as HTMLElement);
        const next = items[(index + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length];
        next?.focus();
    }
    }

    // --- Dark Mode Toggle ---
    settingsBtn.addEventListener('click', toggleMenu);
    const THEME_KEY = 'theme'; // 'light' | 'dark'

    function getStoredTheme(): 'light' | 'dark' {
        const stored = localStorage.getItem(THEME_KEY);
        if (stored === 'light' || stored === 'dark') return stored;
        // Pas de préférence enregistrée → on regarde la préférence système
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function applyTheme(theme: 'light' | 'dark') {
        // Tailwind (darkMode: 'class') : la classe 'dark' sur <html> pilote tout le CSS
        document.documentElement.classList.toggle('dark', theme === 'dark');
        darkSwitch?.classList.toggle('active', theme === 'dark');
        darkSwitch?.setAttribute('aria-checked', String(theme === 'dark'));
        localStorage.setItem(THEME_KEY, theme);

        // Événement personnalisé : d'autres scripts peuvent écouter le changement
        // (ex: recolorer un canvas, changer une image, etc.)
        window.dispatchEvent(new CustomEvent('theme-change', {
            detail: { theme }
        }));
    }

    function toggleTheme() {
        const current = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        applyTheme(current === 'dark' ? 'light' : 'dark');
    }

    // Initialisation au chargement (avant même l'interaction utilisateur)
    applyTheme(getStoredTheme());

    darkSwitch?.addEventListener('click', toggleTheme);

    // --- Exemple d'écouteur externe prêt à l'emploi ---
    // À placer dans n'importe quel autre script qui doit réagir au changement de thème
    window.addEventListener('theme-change', (e: Event) => {
        const { theme } = (e as CustomEvent).detail;
        // Exemple : ici tu pourras plus tard déclencher
        // ta transition de couleurs jour/nuit (ex: overlay, gradient, etc.)
        console.log('Thème changé →', theme);
    });
    if (hero && navbar && !isPinned) {
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            navbar.classList.add('transitioning');
            navbar.offsetHeight;

            if (!entry.isIntersecting) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }

            navbar.dispatchEvent(new CustomEvent('navbar-position-change', {
                detail: { atTop: !entry.isIntersecting }
            }));

            setTimeout(() => {
                navbar.classList.remove('transitioning');
            }, 450);
        });
    }, { threshold: 0 });

    observer.observe(hero);
}
    
</script>

<script is:inline>
    (function() {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'dark' || stored === 'light' 
        ? stored 
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
    })();
</script>

<style>
    .navbar {
    transition: 
        transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
        opacity 0.25s ease,
        top 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
        bottom 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    opacity: 1;
    }
    .navbar {
    top: auto;
    bottom: 0;
    opacity: 1;
    }
    .navbar.scrolled {
    top: 0;
    bottom: auto;
    opacity: 1;
    }
    .navbar.transitioning {
    opacity: 0.3;   
    background-color: transparent;  
    }

    .settings-menu {
    position: absolute;
    right: 0.5rem;
    min-width: 180px;
    padding: 0.5rem;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    z-index: 200;
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 0.15s ease, transform 0.15s ease;
    pointer-events: none;
    background-color: var(--color-primary-300);
    }
    :global(.dark) .settings-menu {
    background-color: var(--color-secondary-500);
}

.settings-menu.open {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
}

/* Position selon état navbar */
.navbar:not(.scrolled) .settings-menu {
  /* Navbar en BAS → menu AU-DESSUS */
    bottom: calc(100% + 8px);
    transform-origin: bottom right;
}

.navbar.scrolled .settings-menu {
  /* Navbar en HAUT → menu EN-DESSOUS */
    top: calc(100% + 8px);
    transform-origin: top right;
}

.settings-menu.open {
    transform: scale(1);
}

.menu-item {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.875rem;
    transition: 0.1s;
}
.menu-item:hover { background: var(--color-primary-700); }
    .dark-switch {
    transition: background-color 0.25s ease;
    cursor: pointer;
    border: none;
    outline-offset: 2px;
}

.switch-knob {
    transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* État actif (dark mode ON) */
.dark-switch.active {
    background-color: var(--color-primary-500, #3b82f6);
}

.dark-switch.active .switch-knob {
    transform: translateX(20px); /* 44px (w-11) - 16px (w-4) - 2*4px (left-1) = 20px */
}

.navbar.pinned {
    top: 0;
    bottom: auto;
    opacity: 1;
}

.navbar.pinned .settings-menu {
    top: calc(100% + 8px);
    bottom: auto;
    transform-origin: top right;
}

</style>