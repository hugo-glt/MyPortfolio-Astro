---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../assets/assets_images/placeholder-1.png';
import Style from '../styles/global.css';
import IndicatorIcon from '../components/icons/IndicatorIcon.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProfileIcon from '../components/icons/ProfileIcon.astro';
import GitlogoIcon from '../components/icons/GithubIcon.astro';
import LinkedinLogoIcon from '../components/icons/LinkdinIcon.astro';
import ResumePlaceholder from '../assets/assets_images/placeholder-resume.jpg';
import Footer from '../components/Footer.astro';
---

<Layout>
	<section id="hero">
		<div class="relative">
			<img src={Placeholder.src} alt="Profile Picture" class="relative w-full"/>
			<div class="absolute left-[3%] top-1/2 -translate-y-1/2 font-bold">
            <h1 class="text-[clamp(2.5rem,8vw,12rem)] leading-none">HUGO</h1>
            <h1 class="text-[clamp(2.5rem,8vw,12em)] leading-none">GILET</h1>
            <h3 class="mt-2 text-[clamp(1rem,3vw,5rem)]">DEVELOPER</h3>
			</div>
		</div>
	</section>

	<section id="presentation" class="mt-30 scroll-mt-15">
		<div class="flex w-fit flex-col items-center mx-auto">
			<h3 class="mt-2 text-[clamp(1rem,3vw,5rem)] font-bold">PRESENTATION</h3>
			<div class="mt-5 h-1 w-[80%] bg-primary-200 dark:bg-secondary-200"></div>
		</div>
		<div  class="mx-auto mt-20 flex max-w-7xl flex-col items-center gap-10 px-6 md:flex-row md:items-center md:gap-30	">
			<div class=" shrink-0 group relative w-fit overflow-hidden">
			<div>
				<img src={ResumePlaceholder.src} alt="Resume" class="block h-auto w-[clamp(400px,25vw,600px)]"/>
			</div>
			<div>
				<div class="absolute inset-0 flex -translate-y-full items-center justify-center bg-gray-500/60 transition-transform duration-500 ease-out group-hover:translate-y-0">
					<a href={ResumePlaceholder.src} download class="text-lg font-bold text-white">
						DOWNLOAD RESUME
					</a>
				</div>
			</div>
		</div>
			<div>
				<span class="text-2xl text-center">lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
				</span>
			</div>
		</div>
		<a href="#contacts" class="flex flex-col items-center justify-center mt-18">
			<span class="font-bold text-sm">
				MORE DETAILS
			</span>
			<IndicatorIcon class="w-5 h-5"/>
		</a>
	</section>
<section class="bg-primary-100 text-gray-900 dark:bg-secondary-100 dark:text-white transition-colors duration-300">
	<section id="projects" class="mt-20 scroll-mt-15">
		<div class="flex flex-col items-center justify-center">
			<div class="flex flex-col w-fit items-center justify-center">
				<h3 class="mt-2 text-[clamp(1rem,3vw,5rem)] font-bold">PROJECTS</h3>
				<div class="mt-5 h-1 w-[80%] bg-primary-200 dark:bg-secondary-200"></div>
			</div>
			<span class="text-center mt-20 m-30 text-2xl">
				lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
			</span>
		</div>
		<section class="mt-5 m-30">
            <ProjectGrid projects={[
  			{ id: 'a', href: '/project-a', image: Placeholder.src, title: 'MyPortfolio', category: 'Astro' },
  			{ id: 'b', href: '/project-b', image: Placeholder.src, title: 'Coming Soon...', category: 'Work in Progress' },
  			{ id: 'c', href: '/project-c', image: Placeholder.src, title: 'Coming Soon...', category: 'Work in Progress' },
  			{ id: 'd', href: '/project-d', image: Placeholder.src, title: 'Coming Soon...', category: 'Work in Progress' },
  			{ id: 'e', href: '/project-e', image: Placeholder.src, title: 'Coming Soon...', category: 'Work in Progress' },
		]} />
		</section>
		<a href="#contacts" class="flex flex-col items-center justify-center mt-5">
			<span class="font-bold text-sm">MORE DETAILS</span>
			<IndicatorIcon class="w-5 h-5"/>
		</a>
	</section>
</section>

	<section id="contacts" class="mt-20 scroll-mt-15">
		<div class="flex flex-col items-center justify-center">
			<div class="flex flex-col w-fit items-center justify-center">
				<h3 class="mt-2 text-[clamp(1rem,3vw,5rem)] font-bold">CONTACTS</h3>
				<div class="mt-5 h-1 w-[80%] bg-primary-200 dark:bg-secondary-200"></div>
			</div>
		</div>
		<div class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-16 md:grid-cols-2 md:gap-24">
			<div class="flex flex-col items-center justify-center mt-20">
				<ProfileIcon class="w-25 h-25 rounded-full"/>
				<div class="mt-14">
					<span class="mx-auto max-w-md text-center">
					lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
					</span>
					<div class="flex items-center justify-center gap-5 mt-5">
						<a href="https://github.com/hugo-glt" target="_blank" rel="noopener noreferrer">
						<GitlogoIcon class="w-10 h-10"/>
						</a>
						<a href="https://www.linkedin.com/in/hugo-gilet-9a2079352" target="_blank" rel="noopener noreferrer">
						<LinkedinLogoIcon class="w-10 h-10"/>
						</a>
					</div>
				</div>
			</div>
			<div class="flex flex-col items-center justify-center mt-20">
				<span class="font-bold">
					SEND ME A MESSAGE !
				</span>
				<form id="contact-form" class="mt-8 flex w-full max-w-md flex-col gap-5">
  					<input type="email" name="email" placeholder="Your Email" required maxlength="254" class="bg-gray-200 text-gray-800 placeholder:text-gray-500 border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500" />
  					<input type="text" name="name" placeholder="Your Name" required maxlength="100" class="bg-gray-200 text-gray-800 placeholder:text-gray-500 border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500" />
  					<textarea name="message" placeholder="Your Message" required maxlength="5000" class="bg-gray-200 text-gray-800 placeholder:text-gray-500 border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>

  				<!-- Honeypot anti-bot -->
  					<input 
    					type="text" 
    					name="website" 
    					autocomplete="off" 
    					tabindex="-1"
    					style="position:absolute; left:-9999px; width:1px; height:1px; opacity:0;" 
    					aria-hidden="true" />

  					<button type="submit" class="bg-primary-900 dark:bg-primary-50 text-white py-2 px-4 rounded">Send</button>
  					<div id="form-alert" class="form-alert" role="status" aria-live="polite" hidden>
    					<span id="form-alert-icon" class="form-alert-icon"></span>
    					<span id="form-alert-text" class="form-alert-text"></span>
  					</div>
				</form>
			</div>	
		</div>
		<a href="#hero" class="flex flex-col items-center justify-center mt-10">
			<span class="font-bold text-sm">
				SCROLL TO TOP
			</span>
			<IndicatorIcon class="w-5 h-5 rotate-180"/>
		</a>
	</section>
</Layout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
const alertBox = document.getElementById('form-alert') as HTMLElement;
const alertIcon = document.getElementById('form-alert-icon') as HTMLElement;
const alertText = document.getElementById('form-alert-text') as HTMLElement;

let hideTimeout: ReturnType<typeof setTimeout>;

function showAlert(type: 'success' | 'error', message: string) {
  	clearTimeout(hideTimeout);

  	alertBox.hidden = false;
  	alertBox.classList.remove('form-alert-success', 'form-alert-error');
  	alertBox.classList.add(type === 'success' ? 'form-alert-success' : 'form-alert-error');
  	alertIcon.textContent = type === 'success' ? '✓' : '✕';
  	alertText.textContent = message;

  // Disparition automatique après 6 secondes (seulement pour un succès)
  	if (type === 'success') {
   		hideTimeout = setTimeout(() => {
      	alertBox.hidden = true;
    }, 6000);
  }
}

form?.addEventListener('submit', async (e) => {
  	e.preventDefault();

  	const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  	submitBtn.disabled = true;

  	const formData = new FormData(form);
  	const payload = {
    name: formData.get('name'),
    	email: formData.get('email'),
    	message: formData.get('message'),
    	website: formData.get('website'),
  };

  	try {
    const res = await fetch('/api/contact', {
    	method: 'POST',
    	headers: { 'Content-Type': 'application/json' },
    	body: JSON.stringify(payload),
    });

    const data = await res.json();

    if (res.ok) {
    	showAlert('success', 'Message envoyé avec succès !');
    	form.reset();
    } else {
    	// Message adapté selon le type d'erreur renvoyé par l'API
    	const message = data.error === 'Trop de tentatives. Réessaie plus tard.'
        ? 'Trop de tentatives, réessaie dans quelques minutes.'
        : 'Une erreur est survenue, vérifie les champs et réessaie.';
    	showAlert('error', message);
    }
	} catch (err) {
    showAlert('error', 'Erreur réseau. Vérifie ta connexion et réessaie.');
	} finally {
    submitBtn.disabled = false;
	}
});
</script>

<style>
	.form-alert {
	display: flex;
  	align-items: center;
  	gap: 0.5rem;
  	padding: 0.75rem 1rem;
  	border-radius: 0.5rem;
  	font-size: 0.875rem;
  	font-weight: 600;
  	animation: alert-fade-in 0.25s ease;
}

.form-alert-icon {
  	display: inline-flex;
  	align-items: center;
  	justify-content: center;
  	width: 1.25rem;
  	height: 1.25rem;
  	border-radius: 9999px;
  	font-size: 0.75rem;
  	flex-shrink: 0;
}

.form-alert-success {
  	background-color: rgba(34, 197, 94, 0.1);
  	color: rgb(21, 128, 61);
  	border: 1px solid rgba(34, 197, 94, 0.3);
}

.form-alert-success .form-alert-icon {
  	background-color: rgb(34, 197, 94);
  	color: white;
}

.form-alert-error {
  	background-color: rgba(239, 68, 68, 0.1);
  	color: rgb(185, 28, 28);
  	border: 1px solid rgba(239, 68, 68, 0.3);
}

.form-alert-error .form-alert-icon {
  	background-color: rgb(239, 68, 68);
  	color: white;
}

@keyframes alert-fade-in {
	from {
    	opacity: 0;
    	transform: translateY(-4px);
  	}
  	to {
    	opacity: 1;
    	transform: translateY(0);
  	}
}
</style>