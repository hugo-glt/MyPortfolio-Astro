---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../assets/assets_images/placeholder-1.png';
import Style from '../styles/global.css';
import IndicatorIcon from '../components/icons/IndicatorIcon.astro';
import Carousel from '../components/Carousel.astro';

const projectNavLinks = [
  { key: 'nav.presentation', label: 'PRESENTATION', href: '#project-a-presentation' },
  { key: 'documentation', label: 'DOCUMENTATION', href: '#carousel-project-a' },
  { key: 'nav.contacts', label: 'CONTACTS', href: '/#contacts' },
];

const projectSlides = [
  {
    title: 'Nom du projet 1',
    text: 'Description courte du projet : contexte, rôle, technologies utilisées et résultat obtenu.',
    imageSrc: Placeholder.src,
    imageAlt: 'Aperçu du projet 1',
  },
  {
    title: 'Nom du projet 2',
    text: 'Description courte du projet : contexte, rôle, technologies utilisées et résultat obtenu.',
    imageSrc: Placeholder.src,
    imageAlt: 'Aperçu du projet 2',
  },
  {
    title: 'Nom du projet 3',
    text: 'Description courte du projet : contexte, rôle, technologies utilisées et résultat obtenu.',
    imageSrc: Placeholder.src,
    imageAlt: 'Aperçu du projet 3',
  },
];
---

<Layout navLinks={projectNavLinks}>
    <section id="hero">
        <div class="relative">
			<img src={Placeholder.src} alt="Project A Picture" class="relative w-full"/>
			<div class="absolute left-[3%] top-1/2 -translate-y-1/2 font-bold">
            <h1 class="text-[clamp(2.5rem,8vw,12rem)] leading-none">PROJECT A</h1>
            <h3 class="mt-2 text-[clamp(1rem,3vw,5rem)]">LANGUAGE USED</h3>
			</div>
		</div>
    </section>
    <section id="project-a-presentation" class="mt-30 scroll-mt-15">
		<div class="flex w-fit flex-col items-center mx-auto">
			<h3 class="mt-2 text-[clamp(1rem,3vw,5rem)] font-bold">PRESENTATION</h3>
			<div class="mt-5 h-1 w-[80%] bg-primary-200 dark:bg-secondary-200"></div>
		</div>
        <div class="mx-auto mt-20 flex max-w-7xl flex-col items-center gap-10 px-6 md:flex-row md:items-center md:gap-30	">
			<span class="text-2xl text-center ">lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
			</span>
		</div>
        <a href="/#contacts" class="flex flex-col items-center justify-center mt-18">
			<span class="font-bold text-sm">
				MORE DETAILS
			</span>
			<IndicatorIcon class="w-5 h-5"/>
		</a>
    </section>
	<section id="carousel-project-a" class="mt-30 scroll-mt-15">
		<div class="flex w-fit flex-col items-center mx-auto">
			<h3 class="mt-2 text-[clamp(1rem,3vw,5rem)] font-bold">DOCUMENTATION</h3>
			<div class="mt-5 h-1 w-[80%] bg-primary-200 dark:bg-secondary-200"></div>
		</div>
		<div class="mx-auto mt-20 p-8 max-w-7xl flex flex-col items-center">
			<Carousel slides={projectSlides} />
		</div>
		<a href="/#contacts" class="flex flex-col items-center justify-center mt-18">
			<span class="font-bold text-sm">
				MORE DETAILS
			</span>
			<IndicatorIcon class="w-5 h-5"/>
		</a>
	</section>
</Layout>

<script define:vars={{placeholderSrc: Placeholder.src}}>
	const projectSlides = [
  	{
    title: 'Nom du projet 1',
    text: 'Description courte du projet : contexte, rôle, technologies utilisées et résultat obtenu.',
    imageSrc: [placeholderSrc],
    imageAlt: 'Aperçu du projet 1',
  	},
  	{
    title: 'Nom du projet 2',
    text: 'Description courte du projet : contexte, rôle, technologies utilisées et résultat obtenu.',
    imageSrc: [placeholderSrc],
    imageAlt: 'Aperçu du projet 2',
  	},
  	{
    title: 'Nom du projet 3',
    text: 'Description courte du projet : contexte, rôle, technologies utilisées et résultat obtenu.',
    imageSrc: [placeholderSrc],
    imageAlt: 'Aperçu du projet 3',
  	},
];

</script>