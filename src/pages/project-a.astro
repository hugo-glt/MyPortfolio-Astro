            <h1 class="text-[clamp(2.5rem,8vw,12rem)] leading-none">PROJECT A</h1>
            <h3 class="mt-2 text-[clamp(1rem,3vw,5rem)]">LANGUAGE USED</h3>
			</div>
		</div>
    </section>
    <section id="presentation" class="mt-30 scroll-mt-15">
		<div class="flex w-fit flex-col items-center mx-auto">
			<h3 class="mt-2 text-[clamp(1rem,3vw,5rem)] font-bold">PRESENTATION</h3>
			<div class="mt-5 h-1 w-[80%] bg-black"></div>
		</div>
