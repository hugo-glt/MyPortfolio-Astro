---
import Layout from "../layouts/Layout.astro";
import Placeholder from "../assets/assets_images/placeholder-1.png";
import Style from "../styles/global.css";
import IndicatorIcon from "../components/icons/IndicatorIcon.astro";
import Carousel from "../components/Carousel.astro";
import PAimage1 from "../assets/assets_images/P2.png";
import PAimage2 from "../assets/assets_images/P3.png";
import PAimage4 from "../assets/assets_images/P6.png";
import PAimage5 from "../assets/assets_images/P5.png";

const projectNavLinks = [
  {
    key: "nav.presentation",
    label: "PRESENTATION",
    href: "#project-a-presentation",
  },
  { key: "documentation", label: "DOCUMENTATION", href: "#carousel-project-a" },
  { key: "nav.contacts", label: "CONTACTS", href: "/#contacts" },
];

const projectSlides = [
  {
    title: "GitHub & Best Practices",
    titleKey: "pa.slide.one.title",
    text: [
      "This project allowed me to become more familiar with GitHub...",
      "To view the source code and all the technical details...",
    ],
    textKey: ["pa.slide.one.text.first", "pa.slide.one.text.second"],
    htmlIndexes: [1],
    imageSrc: PAimage4.src,
    imageAlt: "Aperçu du projet 1",
  },
  {
    title: "Portfolio Development",
    titleKey: "pa.slide.two.title",
    text: [
      "This project was also an opportunity to discover Astro...",
      "I developed a REST API dedicated to the contact form...",
    ],
    textKey: ["pa.slide.two.text.first", "pa.slide.two.text.second"],
    imageSrc: PAimage5.src,
    imageAlt: "Aperçu du projet 2",
  },
  {
    title: "Self-Hosting",
    titleKey: "pa.slide.three.title",
    text: [
      "Part of the project also involves setting up a self-hosted system...",
      "Self-hosting also allows me to have a fully controlled...",
    ],
    textKey: ["pa.slide.three.text.first", "pa.slide.three.text.second"],
    imageSrc: PAimage2.src,
    imageAlt: "Aperçu du projet 3",
  },
];
---

<Layout navLinks={projectNavLinks}>
  <section id="hero">
    <div class="relative">
      <img src={PAimage1.src} alt="Project A Picture" class="relative w-full" />
      <div class="absolute left-[3%] top-1/2 -translate-y-1/2 font-bold">
        <h1 class="text-[clamp(2.5rem,8vw,12rem)] leading-none">MyPORFOLIO</h1>
        <h3 class="mt-2 text-[clamp(1rem,3vw,5rem)]">ASTRO</h3>
      </div>
    </div>
  </section>
  <section id="project-a-presentation" class="mt-30 scroll-mt-15">
    <div class="flex w-fit flex-col items-center mx-auto">
      <h3
        class="mt-2 text-[clamp(1rem,3vw,5rem)] font-bold"
        data-i18n="nav.presentation"
      >
        PRESENTATION
      </h3>
      <div class="mt-5 h-1 w-[80%] bg-primary-200 dark:bg-secondary-200"></div>
    </div>
    <div
      class="mx-auto mt-20 max-w-7xl px-6 flex flex-col items-center text-center"
    >
      <div class="space-y-8 text-center text-lg leading-relaxed md:text-xl">
        <p class="text-2xl text-center" data-i18n="pa.presentation.text.first">
        </p>
        <p class="text-2xl text-center" data-i18n="pa.presentation.text.second">
        </p>
        <p class="text-2xl text-center" data-i18n="pa.presentation.text.third">
        </p>
        <p class="text-2xl text-center" data-i18n="pa.presentation.text.fourth">
        </p>
        <p class="text-2xl text-center" data-i18n="pa.presentation.text.fifth">
        </p>
      </div>
    </div>
    <a
      href="/#contacts"
      class="flex flex-col items-center justify-center mt-18"
    >
      <span class="font-bold text-sm" data-i18n="more.details">
        MORE DETAILS
      </span>
      <IndicatorIcon class="w-5 h-5" />
    </a>
  </section>
  <section id="carousel-project-a" class="mt-30 scroll-mt-15">
    <div class="flex w-fit flex-col items-center mx-auto">
      <h3 class="mt-2 text-[clamp(1rem,3vw,5rem)] font-bold">DOCUMENTATION</h3>
      <div class="mt-5 h-1 w-[80%] bg-primary-200 dark:bg-secondary-200"></div>
    </div>
    <div class="mx-auto mt-20 p-8 max-w-7xl flex flex-col items-center">
      <Carousel slides={projectSlides} />
    </div>
    <a
      href="/#contacts"
      class="flex flex-col items-center justify-center mt-18"
    >
      <span class="font-bold text-sm" data-i18n="more.details">
        MORE DETAILS
      </span>
      <IndicatorIcon class="w-5 h-5" />
    </a>
  </section>
</Layout>
